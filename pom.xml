<project>
    <modelVersion>4.0.0</modelVersion>
    <groupId>com.github.stefanofornari</groupId>
    <artifactId>nb-ste-plugins</artifactId>
    <version>1.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>modules/nb-jwt-editor</module>
        <module>modules/nb-javafx-toolkit</module>
    </modules>
    
    <properties>
        <nb-javafx-toolkit.version>0.0.2</nb-javafx-toolkit.version>
        <nb-jwt-editor.version>0.0.4</nb-jwt-editor.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>collect-nbms</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/repo/nbm" />
                                <copy todir="${project.build.directory}/repo/nbm" flatten="true">
                                    <fileset dir="${project.basedir}/modules" includes="**/target/*.nbm"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.netbeans.utilities</groupId>
                <artifactId>nbm-maven-plugin</artifactId>
                <version>14.4</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>autoupdate</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <!-- Generate autoupdate site from nbms copied into target/repo/nbm -->
                    <distBase>file://${project.build.directory}/repo/nbm</distBase>
                    <outputDirectory>${project.build.directory}/netbeans_site</outputDirectory>
                    <updateSiteIncludes>
                        <param>com.github.stefanofornari:*</param>
                    </updateSiteIncludes>
                </configuration>
            </plugin>


        </plugins>
    </build>
</project>