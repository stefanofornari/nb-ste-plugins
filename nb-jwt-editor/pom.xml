<project>
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.github.stefanofornari</groupId>
    <artifactId>nb-ste-plugins</artifactId>
    <version>0.0.0</version>
  </parent>

  <artifactId>nb-jwt-editor</artifactId>
  <version>${nb-jwt-editor.version}</version>
  <packaging>nbm</packaging> 

  <build>
    <plugins>

      <!-- Step 1: Download the real .nbm from Central -->
      <plugin>
        <groupId>io.github.download-maven-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>2.1.0</version>
        <executions>
          <execution>
            <id>download-upstream-nbm</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <url>${downlaod.url}/${project.version}/${project.artifactId}-${project.version}.nbm</url>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <outputFileName>${project.artifactId}-${project.version}.nbm</outputFileName>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Step 2: Skip the standard jar execution -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Step 3: Skip standard nbm plugin execution -->
      <plugin>
        <groupId>org.apache.netbeans.utilities</groupId>
        <artifactId>nbm-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-manifest</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>default-nbm</id>
            <phase>none</phase>
          </execution>
          <execution>
            <id>default-branding</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>

      <!-- Step 4: Attach downloaded NBM as primary artifact -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>attach-nbm</id>
            <phase>package</phase>
            <goals>
              <goal>attach-artifact</goal>
            </goals>
            <configuration>
              <artifacts>
                <artifact>
                  <file>${project.build.directory}/${project.artifactId}-${project.version}.nbm</file>
                  <type>nbm</type>
                  <classifier>dist</classifier>
                </artifact>
              </artifacts>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>